{
    "name": "kvadrat/laravel-pagebuilder",
    "description": "A drag and drop pagebuilder to manage pages in any Laravel project.",
    "keywords": [
        "laravel",
        "pagebuilder"
    ],
    "license": "MIT",
    "require": {
        "php": ">=8.2",
        "illuminate/support": "^10.0|^11.0|^12.0",
        "hansschouten/phpagebuilder": "^0.31"
    },
    "autoload": {
        "psr-4": {
            "Kvadrat\\LaravelPageBuilder\\": "src/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "extra": {
        "laravel": {
            "providers": [
                "Kvadrat\\LaravelPageBuilder\\ServiceProvider"
            ],
            "aliases": {
                "PageBuilder": "Kvadrat\\LaravelPageBuilder\\Facade"
            }
        }
    }
}
